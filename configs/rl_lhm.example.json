{
  "algorithm": {
    "advantage_estimator": "shae",
    "shae_baseline_beta": 0.95,
    "shae_gate_mid": 0.05,
    "shae_gate_temperature": 0.015,
    "shae_noise_std": 0.001
  },
  "sampler": {
    "use_vgs": true,
    "state_path": "${RL_LHM_RUN_STATE_DIR}/dacvq_vgs_state.json",
    "vq_code_capacity": 64,
    "vq_input_dim": 1152,
    "vq_feature_decay": 0.95,
    "vq_reward_decay": 0.9,
    "vq_difficulty_beta": 3.0,
    "vq_dead_code_thresh": 0.25,
    "vq_dead_code_replace_prob": 0.3,
    "vq_reward_init": 0.0,
    "vq_revival_noise_std": 0.001
  },
  "reward": {
    "mode": "rars",
    "data_mode": "private_5class",
    "risk_matrix_mode": "ordinal",
    "risk_matrix_scale": 1.0,
    "scarcity_alpha": 0.35,
    "confidence_eta": 0.75,
    "severity_kappa": 0.5,
    "classification_giou_threshold": 0.3,
    "reward_clip": [
      -6.0,
      3.0
    ]
  },
  "rollout": {
    "calculate_log_probabilities": true
  },
  "policy": {
    "loss_mode": "vanilla",
    "loss_agg_mode": "token-mean",
    "clip_ratio": 0.2,
    "clip_ratio_low": 0.2,
    "clip_ratio_high": 0.2,
    "clip_ratio_c": 3.0,
    "log_ratio_bounds": [
      -20,
      20
    ],
    "use_kl_loss": true,
    "kl_loss_type": "low_var_kl",
    "kl_loss_coef": 0.01,
    "grad_clip": 1.0,
    "denominator": "global PPO optimizer minibatch retained response tokens",
    "required_carrier_patch": "rl/patch_verl_token_mean.py",
    "reference_commit": "fc3a5acae155425909bc30c982c3cea0784ce3c2"
  }
}
